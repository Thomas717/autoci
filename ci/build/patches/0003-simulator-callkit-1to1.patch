+    #if targetEnvironment(simulator)
+
+        // MARK: - Simulator: outgoing calls without CallKit (CI test patch, not upstream)
+
+        /// In the simulator, CallKit performs the start call action and then disconnects the call within a quarter of
+        /// a second: callservicesd opens `facetime://?showInCallUI=1` for an outgoing call, the simulator has no app
+        /// for that scheme, and callservicesd ends the call "because there wont be a UI to host the call" (iOS 26.5
+        /// and 17.5 alike), which reaches the app as an end call action it did not request. So an outgoing call
+        /// in the simulator never goes to CallKit: no start call action, no end call action, no reports, no
+        /// hold/unhold, and no `provider(_:didActivate:)`; `VoIPCallService` acquires the call's audio claim as a group
+        /// call does, whose driver activates the audio session itself. Everything else, the offer, the answer, ICE,
+        /// WebRTC's media and the hangups, is the app's own call flow. Incoming calls still go to CallKit.
+        ///
+        /// - Returns: `true`: the call was kept away from CallKit
+        private func startCallWithoutCallKit(uuid: UUID, callID: VoIPCallID) -> Bool {
+            simulatorCallsQueue.sync {
+                _ = simulatorCallsWithoutCallKit.insert(uuid)
+            }
+            DDLogNotice(
+                "[Call:1to1:CallKit] [cid=\(callID)]: Simulator: outgoing call without CallKit (callUUID=\(uuid))"
+            )
+            return true
+        }
+
+        /// Whether `startCallWithoutCallKit(uuid:callID:)` kept this call away from CallKit.
+        private func isSimulatorCallWithoutCallKit(_ uuid: UUID) -> Bool {
+            simulatorCallsQueue.sync {
+                simulatorCallsWithoutCallKit.contains(uuid)
+            }
+        }

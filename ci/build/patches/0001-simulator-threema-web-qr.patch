+    #if targetEnvironment(simulator)
+        /// CI test patch, not upstream: the Base64 payload of a Threema Web QR code, entered by hand on a simulator,
+        /// which has no camera (`ThreemaWebSettingsView`). It takes the scanner's path: the passcode `scan()` asks

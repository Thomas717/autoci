+        func connectSimulatorQRPayload(_ payload: String) {
+            guard canScan else {
+                return
+            }
+
+            passcodeRouter.requireAuthenticationIfNeeded(onSuccess: { [weak self] in
+                guard let self else {
+                    return
+                }
+                guard case let .webSession(session, authToken)? = qrCodeParser.parse(
+                    payload.trimmingCharacters(in: .whitespacesAndNewlines)
+                ) else {
+                    alertTitle = #localize("qr_code_scanner_unrecognized_code_error_title")
+                    alertMessage = #localize("qr_code_scanner_unrecognized_code_error_message")
+                    showAlert = true
+                    return
+                }
